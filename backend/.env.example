# Copy this file to `.env` and fill in your keys.

# --- Data provider ---
# Which provider to use: twelvedata (default, AWS-safe) | yfinance (zero-key,
# local testing) | finnhub (note: free tier lacks US candle history).
PRICE_PROVIDER=twelvedata

# Twelve Data — official API, free key at https://twelvedata.com/ (800 calls/day).
TWELVE_DATA_API_KEY=your_twelvedata_key_here

# yfinance needs NO key. To use it, just set PRICE_PROVIDER=yfinance above.

# Finnhub — free key at https://finnhub.io/ (used for fundamentals later; its
# free tier does NOT include US historical candles).
FINNHUB_API_KEY=

# --- Explanation layer (narrative generation) ---
# Which LLM writes the plain-language explanation: gemini | claude
EXPLAIN_PROVIDER=gemini

# Google Gemini — FREE tier key at https://aistudio.google.com/ (no credit card).
GOOGLE_API_KEY=your_google_key_here
# Note: gemini-2.0-flash often has a free-tier limit of 0; use a 2.5 variant.
GEMINI_MODEL=gemini-2.5-flash

# Claude (optional alternative) — https://console.anthropic.com/ (paid, per-token).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- App ---
# SQLite by default. For Postgres later, use e.g.:
#   postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./stock_cache.db
